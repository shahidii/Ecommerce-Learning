    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "description": "Creates a user. `{{$randomInt}}` makes the email unique each time you click Send.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arjun Kumar\",\n  \"email\": \"arjun{{$randomInt}}@example.com\",\n  \"password\": \"Arjun@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "if (res.data?.token) pm.environment.set(\"token\", res.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (demo user)",
