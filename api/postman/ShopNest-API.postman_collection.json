              "mode": "raw",
              "raw": "{\n  \"title\": \"Organic Cotton Bandana Bibs (Pack of 5)\",\n  \"description\": \"Absorbent organic cotton bibs with a soft fleece backing.\",\n  \"brand\": \"Little Nest\",\n  \"price\": 599,\n  \"mrp\": 799,\n  \"categoryId\": \"{{categoryId}}\",\n  \"ageGroupIds\": [\n    \"{{ageGroupId}}\"\n  ],\n  \"stock\": 50,\n  \"thumbnail\": \"https://images.pexels.com/photos/3875082/pexels-photo-3875082.jpeg?auto=compress&cs=tinysrgb&w=600\",\n  \"tags\": [\n    \"bib\",\n    \"organic cotton\"\n  ]\n}",
