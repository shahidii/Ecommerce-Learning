# ─── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ───────────────────────────────────────────
# MongoDB Atlas (tried first). Get it from Atlas → Connect → Drivers.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
# Local MongoDB (used if Atlas is empty or fails)
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/shopnest
# Database name used on both
MONGODB_DB_NAME=shopnest

# ─── Auth (JWT) ─────────────────────────────────────────
# Use a long random string in real projects
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────────────────
# Comma separated list of frontend URLs allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Public URL (used in Swagger "servers") ─────────────
API_BASE_URL=http://localhost:5000

# ─── Logging (optional) ─────────────────────────────────
# trace | debug | info | warn | error | fatal | silent
# Default: debug in development, info in production
# LOG_LEVEL=debug
